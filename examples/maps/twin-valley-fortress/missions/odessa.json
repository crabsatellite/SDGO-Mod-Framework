 "lines": {
  "l01": {
   "portrait": "sprs\\14116.spr",
   "speaker": {
    "zh": "联邦司令部"
   },
   "text": {
    "zh": "全军听令，奥德萨作战开始。夺回矿山基地，把吉翁赶出欧洲！"
   }
  },
  "l02": {
   "portrait": "sprs\\15638.spr",
   "speaker": {
    "zh": "布莱德"
   },
   "text": {
    "zh": "白色基地全机出击！阿姆罗、凯、隼人，按计划从南面突破外围防线！"
   }
  },
  "l03": {
   "portrait": "sprs\\8629.spr",
   "speaker": {
    "zh": "阿姆罗"
   },
   "text": {
    "zh": "明白。高达，出击！"
   }
  },
  "l04": {
   "portrait": "sprs\\9070.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "外围扎古部队已溃散！前方山脊下有导弹阵地，正在锁定友军！"
   }
  },
  "l05": {
   "portrait": "sprs\\8819.spr",
   "speaker": {
    "zh": "凯"
   },
   "text": {
    "zh": "又是导弹啊……好吧，我去把它们拆了！"
   }
  },
  "l12a": {
   "portrait": "sprs\\9070.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "防线突破了！基地指挥官的扎古正在司令部前集结，击破他们！"
   }
  },
  "l04a": {
   "portrait": "sprs\\9070.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "扎古部队已击破！敌方后续部队出现，请肃清剩余的残兵！"
   }
  },
  "l06": {
   "portrait": "sprs\\15638.spr",
   "speaker": {
    "zh": "布莱德"
   },
   "text": {
    "zh": "导弹阵地沉默了。隼人，用钢坦克轰开基地正门！其他人掩护他！"
   }
  },
  "l07": {
   "portrait": "sprs\\8644.spr",
   "speaker": {
    "zh": "隼人"
   },
   "text": {
    "zh": "交给我吧！在打开大门之前，别让敌人靠近！"
   }
  },
  "l08": {
   "portrait": "sprs\\8722.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "截获吉翁通讯——是黑色三连星！三台大魔正高速接近！"
   }
  },
  "l09": {
   "portrait": "sprs\\9070.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "他们说……要发动“喷射气流攻击”！"
   }
  },
  "l10": {
   "portrait": "sprs\\8631.spr",
   "speaker": {
    "zh": "阿姆罗"
   },
   "text": {
    "zh": "三台排成一列冲过来……别慌，先把最前面那台打下来！"
   }
  },
  "l11": {
   "portrait": "sprs\\8632.spr",
   "speaker": {
    "zh": "阿姆罗"
   },
   "text": {
    "zh": "踩着同伴的肩膀……可我也看见你们的破绽了！"
   }
  },
  "l12": {
   "portrait": "sprs\\14116.spr",
   "speaker": {
    "zh": "联邦司令部"
   },
   "text": {
    "zh": "三连星已被击退！闸门开了，全军突入基地核心！"
   }
  },
  "l13": {
   "portrait": "sprs\\8722.spr",
   "speaker": {
    "zh": "芙劳"
   },
   "text": {
    "zh": "基地深处有导弹点火！是……核弹头！马克贝要用核弹攻击我军主力！"
   }
  },
  "l14": {
   "portrait": "sprs\\15638.spr",
   "speaker": {
    "zh": "布莱德"
   },
   "text": {
    "zh": "绝不能让它飞出去！阿姆罗，拦截！只有六十秒！"
   }
  },
  "l15": {
   "portrait": "sprs\\8630.spr",
   "speaker": {
    "zh": "阿姆罗"
   },
   "text": {
    "zh": "核弹……拦下来了。"
   }
  },
  "l16": {
   "portrait": "sprs\\15638.spr",
   "speaker": {
    "zh": "布莱德"
   },
   "text": {
    "zh": "干得好。奥德萨作战，我军胜利！全机返航！"
   }
  }
 },
