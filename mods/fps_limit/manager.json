{
  "schema_version": 1,
  "id": "fps_limit",
  "title": "FPS 上限",
  "category": "gameplay",
  "hosts": [
    "client"
  ],
  "description": "按 config.xml 的 updatefps 设置渲染帧率上限，逻辑更新保持原生 60 Hz。修改后重新启动游戏。",
  "presentation": "configurable",
  "mechanism": "单独保存渲染上限，在原生 Present 入口限制画面提交；逻辑更新及页面切换后的计时器保持 60 Hz，避免高帧率加速移动和 AI。保留原生时钟与累计时间，不改变分辨率。",
  "settings": [
    {
      "id": "frame_limit",
      "label": "FPS 上限",
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 1000,
      "audience": "user",
      "file": "config.xml",
      "section": "Framework/Timer",
      "key": "updatefps",
      "activation": "restart"
    },
    {
      "id": "log_fps",
      "label": "帧率采样日志",
      "type": "boolean",
      "default": false,
      "audience": "developer",
      "file": "mod.ini",
      "section": "settings",
      "key": "LogFps",
      "activation": "restart"
    }
  ]
}
