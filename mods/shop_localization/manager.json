{
  "schema_version": 1,
  "id": "shop_localization",
  "title": "商城中文汉化",
  "category": "gameplay",
  "hosts": [
    "client"
  ],
  "description": "独立商城汉化，翻译现有商品名称、说明和选项；新增商品必须填写中文，并通过玩家更新包分发。",
  "mechanism": "按已校验的商城文字调用点输出中文字典，不改原生价格、币种、租期、SQL或玩家物品。现有英/泰/韩词条单独翻译，截断与直译有标注；未来未登记内容保留原值。新增商品的中文标题从配套display.ini读取，只有原生回复的类别、售价、币种、期限匹配才显示。无额外服务或配置窗口；Manager管理开关、中文必填和玩家包导出。关闭或修改范围后重启客户端生效。",
  "settings": [
    {
      "id": "translatenames",
      "key": "TranslateNames",
      "label": "汉化商品名称",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "translatedescriptions",
      "key": "TranslateDescriptions",
      "label": "汉化商品说明",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "translateoptions",
      "key": "TranslateOptions",
      "label": "汉化商城选项",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    }
  ],
  "presentation": "configurable"
}
