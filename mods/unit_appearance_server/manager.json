{
  "schema_version": 1,
  "distribution": "public",
  "id": "unit_appearance_server",
  "title": "机体外观 · World 服务端",
  "category": "gameplay",
  "hosts": [
    "world"
  ],
  "presentation": "configurable",
  "description": "RGB 涂装与自由贴花分别开关，沿用已保存的机体颜色和贴花位置。",
  "mechanism": "原生涂装页调整颜色，纹章页调整贴纸位置；按机体身份同步到大厅、房间和战斗。保存由 World 校验归属与版本。",
  "dependencies": {
    "required": [
      {
        "id": "friend_unit_gift_server",
        "minimum": "0.1.3"
      }
    ],
    "conflicts": [
      {
        "id": "rgb_paint_server"
      },
      {
        "id": "surface_decal_server"
      }
    ]
  },
  "runtime_enabled_setting": "enabled",
  "settings": [
    {
      "id": "enabled",
      "key": "Enabled",
      "label": "启用机体外观",
      "type": "boolean",
      "default": false,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "rgb_enabled",
      "key": "RgbEnabled",
      "label": "启用 RGB 涂装",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "decals_enabled",
      "key": "DecalsEnabled",
      "label": "启用自由贴花",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    }
  ],
  "consolidates": [
    {
      "id": "rgb_paint_server",
      "setting": "rgb_enabled"
    },
    {
      "id": "surface_decal_server",
      "setting": "decals_enabled"
    }
  ]
}
