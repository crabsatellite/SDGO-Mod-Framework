{
  "schema_version": 1,
  "distribution": "public",
  "id": "unit_catalog",
  "title": "机体内容导入",
  "description": "解析机体包、补齐定义，并在独立客户端的原生商城机体视图及扭蛋 unitview 中核对后导入。登记不自动送机体或上架。",
  "hosts": [
    "client"
  ],
  "category": "gameplay",
  "provider": "units",
  "settings": [
    {
      "id": "enabled",
      "key": "Enabled",
      "label": "机体目录功能",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "form_chains",
      "key": "FormChains",
      "label": "有向多形态模型链（需服务端形态图授权）",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    }
  ],
  "configuration_files": [
    "definitions.json",
    "catalog.bin",
    "presets/catalog.bin",
    "presets/definitions.json",
    "presets/skill-atlases.bin",
    "presets/stage-rules.bin",
    "presets/resource-overlay.ini"
  ],
  "retirement": {
    "content_files": [
      "definitions.json",
      "catalog.bin"
    ]
  },
  "runtime_enabled_setting": "enabled",
  "dependencies": {
    "required": [
      {
        "id": "transform_input_fix",
        "minimum": "1.1.0",
        "capability": "unit.transform_recovery",
        "capability_version": 1,
        "when": {"setting": "form_chains", "equals": true}
      }
    ]
  }
}
