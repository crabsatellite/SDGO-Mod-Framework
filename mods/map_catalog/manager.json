{
  "schema_version": 1,
  "distribution": "public",
  "id": "map_catalog",
  "title": "地图与任务导入",
  "description": "登记协议地图与阶段任务，包含队伍机体行进过场、原生机体横幅、活动范围、护罩反馈及守卫保护目标。不改动原有地图与任务。",
  "hosts": [
    "client"
  ],
  "category": "gameplay",
  "provider": "maps",
  "settings": [
    {
      "id": "enabled",
      "key": "Enabled",
      "label": "导入地图功能",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "native_debug_log",
      "key": "NativeDebugLog",
      "label": "写入游戏原生调试日志（排查任务用）",
      "type": "boolean",
      "default": false,
      "file": "mod.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    }
  ],
  "configuration_files": [
    "catalog.bin",
    "definitions.json",
    "resource-overlay.ini",
    "resources.zdx",
    "resources.zpk",
    "missions.lua",
    "boundaries.bin",
    "damage-gates.bin",
    "retreats.bin"
  ],
  "retirement": {
    "content_files": [
      "catalog.bin",
      "definitions.json",
      "resource-overlay.ini",
      "resources.zdx",
      "resources.zpk",
      "missions.lua",
      "boundaries.bin",
      "damage-gates.bin",
      "retreats.bin"
    ]
  },
  "runtime_enabled_setting": "enabled"
}
