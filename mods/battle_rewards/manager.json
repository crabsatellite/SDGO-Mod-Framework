{
  "schema_version": 1,
  "distribution": "public",
  "id": "battle_rewards",
  "title": "战斗贡献奖励",
  "category": "gameplay",
  "hosts": [
    "battle"
  ],
  "description": "配置战斗贡献、人数倍率、日周目标，以及按账号跨服务器去重的每场/每日/每周聚会奖励。",
  "settings": [
    {
      "id": "runtime_directory",
      "key": "RuntimeDirectory",
      "label": "奖励运行目录",
      "type": "string",
      "default": "",
      "file": "config.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    },
    {
      "id": "instance_id",
      "key": "InstanceId",
      "label": "服务器实例标识",
      "type": "string",
      "default": "",
      "file": "config.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    },
    {
      "id": "gp_policy",
      "key": "GpPolicy",
      "label": "GB 结算策略",
      "description": "replace 使用贡献奖励替换原版 GB；native 保留原版 GB。",
      "type": "choice",
      "default": "replace",
      "options": [
        "replace",
        "native"
      ],
      "file": "config.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    },
    {
      "id": "trace",
      "key": "Trace",
      "label": "诊断日志",
      "type": "boolean",
      "default": false,
      "file": "config.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    }
  ],
  "presentation": "configurable",
  "provider": "rewards",
  "mechanism": "从原生最终结算捕获真实参战统计；GB 沿原通路，基础行显示完整金额并清零已替代的旧 GB 加成，保证动画与跳过结算一致。MB 经持久队列和原生钱包过程去重。日周目标使用原生结算时间、有效时长和实际贡献，跨服务器按钱包账号计数；北京时间每日/每周一重置，固定奖励不乘倍率。Manager 发布不可变策略快照、确认配置并读取真实心跳。"
}
