{
  "schema_version": 1,
  "distribution": "public",
  "id": "shop_labels",
  "title": "商城物品显示",
  "category": "gameplay",
  "hosts": [
    "client"
  ],
  "provider": "shop",
  "description": "显示商城租赁/永久、实际数量和中文选项名；悬停有效期采用紧凑格式，保留价格与原生数值。",
  "settings": [
    {
      "id": "showpermanent",
      "key": "ShowPermanent",
      "label": "显示永久物品标签",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "showrental",
      "key": "ShowRental",
      "label": "显示租赁物品标签",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "useunicodeoverrides",
      "key": "UseUnicodeOverrides",
      "label": "使用自定义中文名称",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    }
  ],
  "presentation": "configurable",
  "provides": {
    "native.text_decoder": 1
  }
}
