{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit form graph controller request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "revision", "roots", "records"],
  "properties": {
    "schema": {"const": "sdgo.unit-form-graphs/1"},
    "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$"},
    "roots": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 10001, "maximum": 30000}
    },
    "records": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "client_sha256"],
        "properties": {
          "id": {"type": "integer", "minimum": 10001, "maximum": 30000},
          "client_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
