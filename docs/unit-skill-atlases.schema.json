{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned native unit skill atlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "revision", "sprites", "skills"],
  "properties": {
    "schema": {"const": "sdgo.unit-skill-atlases/1"},
    "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "revision": {"$ref": "#/$defs/sha256"},
    "sprites": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "textures"],
        "properties": {
          "path": {"type": "string", "maxLength": 80, "pattern": "^sprs/[a-z0-9][a-z0-9_.-]*\\.spr$", "not": {"const": "sprs/0594.spr"}},
          "sha256": {"$ref": "#/$defs/sha256"},
          "textures": {
            "type": "array", "minItems": 1, "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "maxLength": 80, "pattern": "^txrs/[a-z0-9][a-z0-9_.-]*\\.txr$"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "skills": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "record_sha256", "sprite"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 9999999},
          "record_sha256": {"$ref": "#/$defs/sha256"},
          "sprite": {"type": "string", "maxLength": 80, "pattern": "^sprs/[a-z0-9][a-z0-9_.-]*\\.spr$"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
