{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned unit server funnel data library",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "owner", "revision", "funnels"],
  "properties": {
    "schema": {"const": "sdgo.unit-server-funnels/1"},
    "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "revision": {"$ref": "#/$defs/sha256"},
    "funnels": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "client_sha256", "definition"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "client_sha256": {"$ref": "#/$defs/sha256"},
          "definition": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "id", "sha256"],
                "properties": {"kind": {"const": "template"}, "id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "origin", "values"],
                "properties": {
                  "kind": {"const": "explicit"},
                  "origin": {"enum": ["authored", "source-derived", "target-adaptation"]},
                  "values": {
                    "type": "object", "additionalProperties": false,
                    "required": ["FunnelID", "FunnelProp", "AniTime", "AttackDelay", "AttackCount", "Stealable"],
                    "properties": {
                      "FunnelID": {"$ref": "#/$defs/id"},
                      "FunnelProp": {"type": "integer", "minimum": 0, "maximum": 255},
                      "AniTime": {"$ref": "#/$defs/positiveInt32"},
                      "AttackDelay": {"$ref": "#/$defs/positiveInt32"},
                      "AttackCount": {"type": "integer", "minimum": 0, "maximum": 255},
                      "Stealable": {"type": "integer", "minimum": 0, "maximum": 255}
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "description": "Authoring only; runtime writers reject drafts.",
                "required": [
                  "kind",
                  "origin",
                  "values"
                ],
                "properties": {
                  "kind": {
                    "const": "draft"
                  },
                  "origin": {
                    "enum": [
                      "authored",
                      "source-derived",
                      "target-adaptation"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "FunnelID"
                    ],
                    "properties": {
                      "FunnelID": {
                        "$ref": "#/$defs/id"
                      },
                      "FunnelProp": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "AniTime": {
                        "$ref": "#/$defs/positiveInt32"
                      },
                      "AttackDelay": {
                        "$ref": "#/$defs/positiveInt32"
                      },
                      "AttackCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "Stealable": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1, "maximum": 9999999},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInt32": {"type": "integer", "minimum": 0, "maximum": 2147483647}
  }
}
