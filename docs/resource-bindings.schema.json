{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned original-constructor resource bindings",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "owner", "revision", "resources", "weapons", "fixedEffects"],
  "properties": {
    "schema": {"const": "sdgo:resource-bindings/1"},
    "owner": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "maxLength": 48},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 240}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "weapons": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "member", "sha256"], "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "member": {"type": "string", "minLength": 1, "maxLength": 1024}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "fixedEffects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["weapon", "target"], "properties": {"weapon": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "target": {"type": "string", "minLength": 1, "maxLength": 240}}}}
  }
}
