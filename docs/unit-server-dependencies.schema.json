{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned unit server skill data library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "revision", "skills"],
  "properties": {
    "schema": {"const": "sdgo.unit-server-dependencies/1"},
    "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "revision": {"$ref": "#/$defs/sha256"},
    "skills": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "client_sha256", "definition"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "client_sha256": {"$ref": "#/$defs/sha256"},
          "definition": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "id", "sha256"],
                "properties": {
                  "kind": {"const": "template"},
                  "id": {"$ref": "#/$defs/id"},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "origin", "values"],
                "properties": {
                  "kind": {"const": "explicit"},
                  "origin": {"enum": ["authored", "source-derived", "target-adaptation"]},
                  "values": {"$ref": "#/$defs/values"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "integer", "minimum": 1, "maximum": 9999999},
    "byte": {"type": "integer", "minimum": 0, "maximum": 255},
    "short": {"type": "integer", "minimum": -32768, "maximum": 32767},
    "real": {"type": "number", "minimum": -3.4e38, "maximum": 3.4e38},
    "values": {
      "type": "object", "additionalProperties": false,
      "required": ["SkillID", "SkillName", "Activate", "ActivateValue", "MoveLv", "DashLv", "QuickLv", "MotiveLv", "BoostIncreaseRate", "BoostPower", "Attack", "Defense", "RadarRadius", "SpIncreaseRate", "Scale", "AutoBulletChargeRate", "BulletChargeRate", "AtkSpdRate", "ActiveResult", "Feature", "UseTarget", "BattleMode", "PartSpLevel"],
      "properties": {
        "SkillID": {"$ref": "#/$defs/id"},
        "SkillName": {"type": "string", "minLength": 1, "maxLength": 50},
        "Activate": {"$ref": "#/$defs/byte"},
        "ActivateValue": {"$ref": "#/$defs/short"},
        "MoveLv": {"$ref": "#/$defs/short"}, "DashLv": {"$ref": "#/$defs/short"},
        "QuickLv": {"$ref": "#/$defs/short"}, "MotiveLv": {"$ref": "#/$defs/short"},
        "BoostIncreaseRate": {"$ref": "#/$defs/real"}, "BoostPower": {"$ref": "#/$defs/short"},
        "Attack": {"$ref": "#/$defs/short"}, "Defense": {"$ref": "#/$defs/short"},
        "RadarRadius": {"$ref": "#/$defs/short"}, "SpIncreaseRate": {"$ref": "#/$defs/short"},
        "Scale": {"$ref": "#/$defs/real"}, "AutoBulletChargeRate": {"$ref": "#/$defs/real"},
        "BulletChargeRate": {"$ref": "#/$defs/real"}, "AtkSpdRate": {"$ref": "#/$defs/real"},
        "ActiveResult": {"$ref": "#/$defs/short"}, "Feature": {"$ref": "#/$defs/byte"},
        "UseTarget": {"$ref": "#/$defs/byte"}, "BattleMode": {"$ref": "#/$defs/byte"},
        "PartSpLevel": {"$ref": "#/$defs/byte"}
      }
    }
  }
}
